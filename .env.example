# NitroStack Configuration
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=universal

# Server Transport Configuration (Optional)
# =============================================================================
# MCP_TRANSPORT_TYPE: Toggles transport mode. Values: stdio | http | dual.
# Defaults to 'stdio' in development and 'dual' in production/NODE_ENV=production.
# =============================================================================
# MCP_TRANSPORT_TYPE=stdio
# PORT=3000
# HOST=localhost
# ENABLE_CORS=true

# ALE SCM — Required
# =============================================================================
ANTHROPIC_API_KEY=sk-ant-...        # Claude API key
ALE_API_KEY=your-secret-key-here    # x-api-key header value for MCP clients

# SQLite Cloud — Master Data store
# =============================================================================
# Format: sqlitecloud://<user>:<apikey>@<host>.sqlite.cloud:8860/<database>.sqlite
# Get your connection string from https://dashboard.sqlitecloud.io
SQLITECLOUD_URL=sqlitecloud://user:apikey@host.sqlite.cloud:8860/ale-scm.sqlite
