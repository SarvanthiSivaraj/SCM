# NitroStack Configuration
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=universal

# Server Transport Configuration (Optional)
# =============================================================================
# MCP_TRANSPORT_TYPE: Toggles transport mode. Values: stdio | http | dual.
# Defaults to 'stdio' in development and 'dual' in production/NODE_ENV=production.
# =============================================================================
# MCP_TRANSPORT_TYPE=stdio
# PORT=3000
# HOST=localhost
# ENABLE_CORS=true

# ALE SCM — Required
# =============================================================================
ANTHROPIC_API_KEY=sk-ant-...        # Claude API key
ALE_API_KEY=your-secret-key-here    # x-api-key header value for MCP clients

# SQLite Cloud — Master Data store
# =============================================================================
# Format: sqlitecloud://<user>:<apikey>@<host>.sqlite.cloud:8860/<database>.sqlite
# Get your connection string from https://dashboard.sqlitecloud.io
SQLITECLOUD_URL=sqlitecloud://user:apikey@host.sqlite.cloud:8860/ale-scm.sqlite

# Communication & Alerting — SMTP (Phase 2)
# =============================================================================
# All SMTP vars are OPTIONAL. If absent the module starts in dry-run mode
# (alerts are queued in SQLite but not delivered). Set these to enable real email.
#
# ── Option A: Gmail SMTP (free, 500 emails/day) ──────────────────────────────
# 1. Enable 2-Step Verification in your Google Account
# 2. Go to: myaccount.google.com → Security → App Passwords
# 3. Generate an App Password for "Mail" and paste it as SMTP_PASS
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx      # 16-char App Password (NOT your Gmail password)
SMTP_FROM=ALE SCM Alerts <you@gmail.com>
#
# ── Option B: Brevo / Sendinblue (free tier: 300 emails/day) ─────────────────
# Sign up at https://app.brevo.com → SMTP & API → SMTP tab → Copy credentials
#
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-login@example.com
# SMTP_PASS=your-brevo-smtp-key
# SMTP_FROM=ALE SCM Alerts <alerts@yourdomain.com>

# Communication & Alerting — Worker
# =============================================================================
ALERT_FLUSH_INTERVAL_MS=10000      # How often the worker flushes the queue (ms, default 10s)
SLA_ESCALATION_HOURS=24            # Hours before an unresolved exception triggers an escalation

# Communication & Alerting — IMAP inbox (optional, enables ingest_email_inbox)
# =============================================================================
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_USER=inbox@yourdomain.com
# IMAP_PASS=xxxx-xxxx-xxxx-xxxx
